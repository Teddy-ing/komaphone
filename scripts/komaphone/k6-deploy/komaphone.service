[Unit]
Description=Komaphone private sync service
After=network.target
RequiresMountsFor=/var/lib/komaphone
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=komaphone
Group=komaphone
WorkingDirectory=/var/lib/komaphone
ExecStart=/opt/komaphone/current/photocraft-sync --bind 127.0.0.1:43127 --data-dir /var/lib/komaphone --quota-mib 2048 --canvas-member-limit 4096 --canvas-presence-limit 256
Restart=on-failure
RestartSec=5
# Current service handles SIGINT for graceful shutdown, not SIGTERM.
KillSignal=SIGINT
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/komaphone
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
TasksMax=128
MemoryHigh=768M
MemoryMax=1G
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
